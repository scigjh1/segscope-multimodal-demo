FROM pytorch/pytorch:2.1.0-cuda12.1-cudnn8-runtime
WORKDIR /app
COPY requirements-gpu.txt .
RUN python -m pip install --no-cache-dir -r requirements-gpu.txt
COPY gpu_runtime ./gpu_runtime
COPY static ./static
COPY benchmark_results ./benchmark_results
ENV SEG_SCOPE_DATA_DIR=/private/case-store
EXPOSE 4186
CMD ["python", "-m", "uvicorn", "gpu_runtime.api:app", "--host", "0.0.0.0", "--port", "4186"]
